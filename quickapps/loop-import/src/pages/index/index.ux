<template>
  <div class="page" onswipe="onSwipe">
    <image class="back" src="/common/back.png" onclick="onBack"></image>
    <text class="time">{{ time }}</text>
    <text class="nav-title">同步内容</text>
    <image class="hero" src="{{ heroSrc }}"></image>
    <text class="headline">{{ headline }}</text>
    <text class="hint">{{ hint }}</text>
  </div>
</template>

<script>
import app from '@system.app'
import file from '@system.file'
import interconnect from '@system.interconnect'

const ROOT = 'internal://files/loop'
const SCHEDULE_URI = ROOT + '/schedule.json'
const SCHEDULE_TMP = ROOT + '/schedule.json.tmp'
const PROTOCOL_VERSION = 1
const MAX_SCHEDULE_BYTES = 40960
const HINT_WAIT = '请打开课表导入插件\n准备上传内容'
const HINT_HAS_SCHEDULE = '本地已存在课表\n也可继续接收覆盖推送'
const HERO_CONNECT = '/common/hero-connect.png'
const HERO_SELECT = '/common/hero-select.png'
const HERO_DOWNLOAD = '/common/hero-download.png'
const HERO_SUCCESS = '/common/hero-success.png'
const HERO_FAIL = '/common/hero-fail.png'

export default {
  private: {
    connect: null,
    operation: null,
    clockTimer: null,
    time: '00:00',
    headline: '等待 AstroBox 连接',
    hint: HINT_WAIT,
    heroSrc: HERO_CONNECT,
    status: '等待 AstroBox 连接'
  },
  onInit() {
    this.tickClock()
    this.operation = Promise.resolve()
    this.connect = interconnect.instance()
    this.connect.onopen = (data) => {
      if (data && data.isReconnected) {
        this.setIdleView('已重新连接', HERO_SELECT)
      } else {
        this.setIdleView('已连接，等待推送', HERO_SELECT)
      }
    }
    this.connect.onclose = () => {
      this.setView('连接已断开', '请保持本页打开\n等待重新连接', HERO_CONNECT)
    }
    this.connect.onerror = (data) => {
      const reason = data && data.data ? String(data.data) : '未知'
      this.setView('连接错误', reason, HERO_FAIL)
    }
    this.connect.onmessage = (event) => {
      const payload = event && event.data !== undefined ? event.data : event
      this.operation = this.operation
        .then(() => this.handleMessage(payload))
        .catch((error) => {
          const reason = error && error.message ? error.message : String(error)
          this.setView('处理失败', reason, HERO_FAIL)
          this.sendError('', 'io-error', reason)
        })
    }
  },
  onReady() {
    this.startClock()
    interconnect.getReadyState({
      success: (data) => {
        if (data.status === 1) {
          this.setIdleView('已连接，等待推送', HERO_SELECT)
        } else {
          this.setIdleView('等待 AstroBox 连接', HERO_CONNECT)
        }
      },
      fail: () => {
        this.setIdleView('等待 AstroBox 连接', HERO_CONNECT)
      }
    })
  },
  onShow() {
    this.startClock()
    if (this.heroSrc === HERO_CONNECT || this.heroSrc === HERO_SELECT) {
      this.setIdleView(this.headline, this.heroSrc)
    }
  },
  onHide() {
    this.stopClock()
  },
  onDestroy() {
    this.stopClock()
  },
  onBackPress() {
    app.terminate()
    return true
  },
  pad2(value) {
    return value < 10 ? '0' + value : '' + value
  },
  tickClock() {
    const now = new Date()
    this.time = this.pad2(now.getHours()) + ':' + this.pad2(now.getMinutes())
  },
  startClock() {
    this.tickClock()
    if (this.clockTimer) return
    this.clockTimer = setInterval(() => {
      this.tickClock()
    }, 10000)
  },
  stopClock() {
    if (!this.clockTimer) return
    clearInterval(this.clockTimer)
    this.clockTimer = null
  },
  setView(headline, hint, heroSrc) {
    this.headline = headline
    this.hint = hint
    this.status = headline
    if (heroSrc) {
      this.heroSrc = heroSrc
    }
  },
  async setIdleView(headline, heroSrc) {
    const hasSchedule = await this.access(SCHEDULE_URI)
    this.setView(headline, hasSchedule ? HINT_HAS_SCHEDULE : HINT_WAIT, heroSrc)
  },
  onBack() {
    app.terminate()
  },
  onSwipe(evt) {
    if (evt && evt.direction === 'right') {
      this.onBack()
    }
  },
  send(message) {
    // 与 Lyra Import 一致：传对象，由系统序列化；勿预先 JSON.stringify，否则插件端会双重解码失败。
    if (!this.connect) return
    this.connect.send({
      data: message,
      fail: (data, code) => {
        this.setView('回复失败', String(data || code), HERO_FAIL)
      }
    })
  },
  sendError(id, code, message) {
    this.send({
      tag: 'loop-import-error',
      version: PROTOCOL_VERSION,
      id: id || '',
      code,
      message: String(message || 'error')
    })
  },
  async handleMessage(payload) {
    let message = payload
    if (typeof message === 'string') {
      message = JSON.parse(message)
    }
    if (!message || typeof message !== 'object') {
      throw new Error('invalid message')
    }
    switch (message.tag) {
      case 'loop-import-hello':
        this.send({
          tag: 'loop-import-hello',
          version: PROTOCOL_VERSION,
          ok: true,
          maxScheduleBytes: MAX_SCHEDULE_BYTES
        })
        this.setIdleView('已握手，等待课表', HERO_SELECT)
        return
      case 'loop-import-publish':
        await this.handlePublish(message)
        return
      default:
        return
    }
  },
  validateSchedule(schedule) {
    if (!schedule || typeof schedule !== 'object') {
      throw new Error('schedule missing')
    }
    if (schedule.version !== 1) {
      throw new Error('schedule.version must be 1')
    }
    if (!schedule.term || typeof schedule.term !== 'object') {
      throw new Error('schedule.term missing')
    }
    if (!schedule.term.name) {
      throw new Error('schedule.term.name missing')
    }
    if (!schedule.term.start_date) {
      throw new Error('schedule.term.start_date missing')
    }
    if (!Array.isArray(schedule.courses)) {
      throw new Error('schedule.courses must be an array')
    }
  },
  async handlePublish(message) {
    const id = message && message.id ? String(message.id) : ''
    try {
      if (message.version !== PROTOCOL_VERSION) {
        throw new Error('unsupported protocol version')
      }
      const schedule = message.schedule
      this.validateSchedule(schedule)
      const text = JSON.stringify(schedule)
      if (text.length > MAX_SCHEDULE_BYTES) {
        throw new Error('schedule exceeds maxScheduleBytes')
      }
      this.setView('正在写入课表', '请保持本页打开', HERO_DOWNLOAD)
      await this.publishText(text)
      const courses = Array.isArray(schedule.courses) ? schedule.courses.length : 0
      this.send({
        tag: 'loop-import-ack',
        version: PROTOCOL_VERSION,
        id,
        courses
      })
      this.setView(
        '写入完成',
        '已写入 ' + courses + ' 门课\n打开 Loop 即可使用',
        HERO_SUCCESS
      )
    } catch (error) {
      const reason = error && error.message ? error.message : String(error)
      this.sendError(id, 'publish-failed', reason)
      this.setView('写入失败', reason, HERO_FAIL)
    }
  },
  ensureDir() {
    return new Promise((resolve, reject) => {
      file.access({
        uri: ROOT,
        success: () => resolve(),
        fail: () => {
          file.mkdir({
            uri: ROOT,
            success: () => resolve(),
            fail: (err) => reject(err)
          })
        }
      })
    })
  },
  writeText(uri, text) {
    return new Promise((resolve, reject) => {
      file.writeText({
        uri,
        text,
        success: () => resolve(),
        fail: (err) => reject(err)
      })
    })
  },
  move(src, dst) {
    return new Promise((resolve, reject) => {
      file.move({
        srcUri: src,
        dstUri: dst,
        success: () => resolve(),
        fail: (err) => reject(err)
      })
    })
  },
  access(uri) {
    return new Promise((resolve) => {
      file.access({
        uri,
        success: () => resolve(true),
        fail: () => resolve(false)
      })
    })
  },
  async publishText(jsonText) {
    await this.ensureDir()
    await this.writeText(SCHEDULE_TMP, jsonText)
    const exists = await this.access(SCHEDULE_URI)
    if (exists) {
      try {
        await this.move(SCHEDULE_TMP, SCHEDULE_URI)
      } catch (e) {
        await this.writeText(SCHEDULE_URI, jsonText)
      }
    } else {
      await this.move(SCHEDULE_TMP, SCHEDULE_URI)
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
}
.back {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 72px;
  height: 72px;
  object-fit: contain;
}
.time {
  position: absolute;
  left: 0px;
  top: 10px;
  width: 336px;
  height: 32px;
  font-size: 24px;
  line-height: 32px;
  font-weight: bold;
  color: #999999;
  text-align: center;
}
.nav-title {
  position: absolute;
  left: 0px;
  top: 40px;
  width: 336px;
  height: 40px;
  font-size: 32px;
  line-height: 40px;
  font-weight: normal;
  color: #FFFFFF;
  text-align: center;
}
.hero {
  position: absolute;
  left: 104px;
  top: 146px;
  width: 128px;
  height: 128px;
  object-fit: contain;
}
.headline {
  position: absolute;
  left: 16px;
  top: 300px;
  width: 304px;
  height: 40px;
  font-size: 32px;
  line-height: 40px;
  font-weight: normal;
  color: #FFFFFF;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}
.hint {
  position: absolute;
  left: 24px;
  top: 358px;
  width: 288px;
  height: 72px;
  font-size: 26px;
  line-height: 36px;
  font-weight: normal;
  color: #999999;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
</style>
